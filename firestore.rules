rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Compatibility fallback for root collections used by existing Firebase clients.
    match /users/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /actorProfiles/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Admin member projections are available only through the Firebase Admin SDK.
    match /adminMembers/{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Compatibility fallback for root collections used by existing Firebase clients.
    match /users/{document=**} {
      allow read: if request.auth != null;
      // The affiliate attribution is written by the server when the account is
      // created. A member must not be able to claim a referral, or move an
      // existing one, from the browser.
      allow create: if request.auth != null
        && !request.resource.data.keys().hasAny(['affiliateCode', 'affiliateCapturedAt']);
      allow update: if request.auth != null
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['affiliateCode', 'affiliateCapturedAt']);
    }

    match /actorProfiles/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Admin member projections are available only through the Firebase Admin SDK.
    match /adminMembers/{document=**} {
      allow read, write: if false;
    }
  }
}
